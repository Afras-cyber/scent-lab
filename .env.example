# Copy to .env.local. Brand and contact values (name, phone, WhatsApp number)
# live in src/config, not here. Validated by src/lib/env-schema.ts.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local values from `npm run supabase:status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-secret-key   # server only, bypasses RLS, never NEXT_PUBLIC

# --- Needed from later phases (optional until then) ---

# NextAuth / Auth.js v5 (Phase 4). Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Abuse protection (Phase 2)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signed invoice/receipt links shared over WhatsApp (Phase 3), server only.
# WhatsApp itself needs no keys: it is click-to-chat (wa.me) only.
INVOICE_LINK_SECRET=

# Cache revalidation webhook (Phase 1)
REVALIDATE_SECRET=

# Build switches
# SKIP_ENV_VALIDATION=true          # skip the env check in `next build`
# ALLOW_CONFIG_PLACEHOLDERS=true    # allow TODO/**** in src/config (CI and previews only)
